# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
test_out.txt

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug & server logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev-server.log
dev-server.err.log
prod-server.log
prod-server.err.log
build-error.log
build_error.log

# local env files
.env
.env*.local
.env.production
.env.staging

# payload
payload.db
payload.db.bak
media/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# playwright
.playwright-mcp/
.playwright-cli/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# local temporary scripts
.tmp/

# generated reports
*.report.html
localhost_*.report.html

# content strategy context (docs — not app code)
/content-strategy-context/

# local SEO workspace (not app code)
/claude-seo/

# claude code local harness config
.claude/

# ad-hoc test/one-off scripts
test-db.js
test-payload.ts
test_out.txt
all-site-urls.txt
all-urls.txt

# dev archive — one-off scripts, SQL, backups (not needed in production)
/_dev-archive/

# empty local-only folders
/assets/

# seed scripts (dev-only, not deployed)
src/seed.ts
src/seed-bkc.ts

# python cache (from claude-seo or other tooling)
__pycache__/
*.py[cod]
*$py.class
