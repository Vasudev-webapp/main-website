# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
test_out.txt

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# ── secrets & credentials — never commit ──
# Deployment exclusions live in .vercelignore, not here. Anything listed in this
# block is a credential: committing one means rotating it, so keep the patterns
# broad. Real values belong in Vercel env vars or an untracked local .env.local.
*.key
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
*service-account*.json
*serviceaccount*.json
gsc-*.json
/secrets/
# Google service-account key downloads default to "<project-id>-<hex>.json".
# Matches a dash followed by 8+ hex characters, which no normal config file has
# (package-lock.json, money-keywords.json and friends are unaffected).
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json

# debug & server logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev-server.log
dev-server.err.log
prod-server.log
prod-server.err.log
build-error.log
build_error.log

# local env files
.env
.env*.local
.env.production
.env.staging

# payload
payload.db
payload.db.bak
media/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# playwright
.playwright-mcp/
.playwright-cli/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# local temporary scripts
.tmp/

# ── local-only SEO tooling (not needed for production) ──
# Search Console toolkit and its output stay on the local machine. They are
# never imported by the app, so excluding them cannot affect a build.
# Trade-off accepted: these files are NOT backed up by git, so a lost machine
# loses them. scripts/gsc/money-keywords.json in particular holds the tracked
# money-keyword KPI definition — keep a copy somewhere safe.
# The npm run seo:gsc:* entries in package.json remain and will only work on a
# machine that has these files present.
/scripts/gsc/
/reports/
!/reports/gsc/
!/reports/gsc/*.md

# generated reports
*.report.html
localhost_*.report.html

# Search Console raw snapshots (large, regenerable via npm run seo:gsc:pull).
# reports/gsc/*.md is intentionally NOT ignored — keep the weekly action history.
/data/gsc/

# content strategy context (docs — not app code)
/content-strategy-context/

# local SEO workspace (not app code)
/claude-seo/

# claude code local harness config
.claude/

# ad-hoc test/one-off scripts
test-db.js
test-payload.ts
test_out.txt
all-site-urls.txt
all-urls.txt

# dev archive — one-off scripts, SQL, backups (not needed in production)
/_dev-archive/

# empty local-only folders
/assets/

# seed scripts (dev-only, not deployed)
src/seed.ts
src/seed-bkc.ts

# python cache (from claude-seo or other tooling)
__pycache__/
*.py[cod]
*$py.class
