PAYLOAD_SECRET=your-random-secret-here
DATABASE_URI=postgresql://user:password@host:5432/database

# ── Gmail SMTP (contact form email delivery) ──────────────────────────────────
# Use a Gmail App Password (not your regular Gmail password).
# Enable 2FA on the Gmail account first, then:
# Google Account → Security → 2-Step Verification → App passwords → Generate
SMTP_USER=vasudevchemopharma@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email address that receives all inquiry leads
CONTACT_EMAIL_TO=info@vasudevchemopharma.com

# ── Google Search Console API (SEO automation) ────────────────────────────────
# An API key does NOT work with this API. Use a service account:
#   1. Cloud Console → APIs & Services → Library → enable "Google Search Console API"
#   2. Credentials → Create credentials → Service account (skip the IAM role step)
#   3. Open the service account → Keys → Add key → Create new key → JSON
#   4. Search Console → Settings → Users and permissions → Add user
#      → paste the service-account email → Permission: Full
# Verify with: npm run seo:gsc:verify

# Exact property string from Search Console. Format matters (mismatch = 403):
#   domain property → sc-domain:vasudevchemopharma.com
#   URL-prefix      → https://www.vasudevchemopharma.com/   (keep trailing slash)
GSC_SITE_URL=sc-domain:vasudevchemopharma.com

# Option 1 (local dev): absolute path to the downloaded key file.
# Keep it outside the repo, or in /secrets/ which is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\secrets\gsc-service-account.json

# Option 2 (Vercel / CI): inline the two fields from that JSON instead.
# Keep the literal \n escapes and the surrounding double quotes.
# GSC_CLIENT_EMAIL=gsc-seo-reader@your-project.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----\n"
